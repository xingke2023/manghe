/* 首页盲盒广场。
   版式参考 gemini-3.1-pro-preview 的方案：头部改为「我 + 配额卡」左右分布、
   Tab 吸顶带毛玻璃、筛选区从两排胶囊改为「文字排 + chip 排」、
   关注列表的横滑轮播出血到屏宽。 */

.plaza {
  min-height: 100vh;
  background-color: var(--color-bg);
  padding-bottom: 60rpx;
}

/* —— 渐变头部 —— */
.hero {
  position: relative;
  background: linear-gradient(135deg, #fff0e8 0%, #fff6f2 40%, var(--color-bg) 100%);
  padding: 32rpx 32rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

/* 左侧：我的头像 + 昵称 + 会员号 + 状态胶囊 */
.me {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}
.me-avatar-wrap {
  border: 4rpx solid var(--color-card);
  border-radius: 9999rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
  line-height: 0;
}
.me-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.me-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.me-name {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.2;
  max-width: 240rpx;
}
/* 会员号用等宽字体，数字对齐更整齐、也更像一个「号」 */
.me-no {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background-color: rgba(255, 255, 255, 0.6);
  flex-shrink: 0;
}
.me-no-label {
  font-size: var(--fs-mini);
  color: var(--color-text-secondary);
  font-family: 'SF Mono', Menlo, monospace;
}
.me-no-copy {
  font-size: var(--fs-mini);
  color: var(--color-text-hint);
}
.me-login-hint {
  font-size: var(--fs-secondary);
  color: var(--color-text-secondary);
}
.me-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.me-pill {
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  background-color: var(--color-card);
  font-size: var(--fs-mini);
  color: var(--color-text-secondary);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}
.me-pill.is-vip {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  color: #b45309;
  font-weight: 500;
}

/* 右侧：今日剩余拆盒次数 */
.quota-card {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  background-color: var(--color-card);
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}
.quota-icon {
  font-size: 36rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}
.quota-text {
  font-size: var(--fs-mini);
  color: var(--color-text-hint);
  margin-bottom: 4rpx;
}
.quota-val {
  display: flex;
  align-items: baseline;
}
.quota-hl {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--color-accent);
  line-height: 1;
}
.quota-total {
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
  margin-left: 4rpx;
}

/* —— Tab：吸顶 + 毛玻璃（backdrop-filter 不生效时靠半透明底色兜底） —— */
.tabs {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  background-color: rgba(245, 245, 245, 0.9);
  backdrop-filter: blur(12rpx);
  padding: 0 40rpx;
  gap: 56rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}
.tab {
  position: relative;
  padding: 28rpx 0 24rpx;
  /* 字号保持恒定 —— 选中时改字号会让 Tab 栏在切换时抖动 */
  font-size: var(--fs-section);
  color: var(--color-text-secondary);
}
.tab.is-active {
  color: var(--color-text);
  font-weight: 600;
}
.tab.is-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 32rpx;
  height: 8rpx;
  border-radius: 8rpx 8rpx 0 0;
  background-color: var(--color-accent);
}

/* —— 筛选区：上排纯文字（轻），下排 chip（可横滑） —— */
.filters {
  background-color: var(--color-bg);
  padding: 24rpx 0 16rpx;
}
.filter-bar {
  display: flex;
  padding: 0 32rpx;
  gap: 40rpx;
  margin-bottom: 24rpx;
}
.filter-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
}
.filter-item.is-active {
  color: var(--color-text);
  font-weight: 600;
}
.filter-icon {
  font-size: var(--fs-mini);
  color: var(--color-text-hint);
}
.filter-item.is-active .filter-icon {
  color: var(--color-text);
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}
.category-row {
  display: inline-flex;
  padding: 0 32rpx;
  gap: 20rpx;
}
.category-chip {
  padding: 12rpx 32rpx;
  border-radius: 9999rpx;
  background-color: var(--color-card);
  border: 2rpx solid transparent;
  font-size: var(--fs-secondary);
  color: var(--color-text-secondary);
}
.category-chip.is-active {
  background-color: var(--color-accent-bg);
  border-color: rgba(232, 55, 63, 0.2);
  color: var(--color-accent);
  font-weight: 500;
}

/* —— 列表区 ——
   卡片自身不带外边距，间距统一由这里的 gap 控制 */
.list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.list-footer {
  padding: 16rpx 0 32rpx;
  text-align: center;
}
.list-footer-text {
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
}

/* —— 我关注的：按发盒者分组 —— */
.group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.group-head-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.group-name {
  font-size: var(--fs-section);
  font-weight: 600;
  color: var(--color-text);
  max-width: 300rpx;
}
.group-count {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  background-color: var(--gray-100);
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
}
.group-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: var(--gray-400);
}
/* 轮播出血到屏宽，左右各抵掉 .list 的 32rpx padding */
.group-scroll {
  width: 100vw;
  margin-left: -32rpx;
  white-space: nowrap;
}
.group-row {
  display: inline-flex;
  padding: 0 32rpx 16rpx;
  gap: 24rpx;
}

/* —— 发盒悬浮按钮 —— */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  z-index: 100;
  padding: 28rpx 48rpx;
  border-radius: 9999rpx;
  background-color: var(--gray-900);
  color: #ffffff;
  font-size: var(--fs-body);
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.fab-icon {
  font-size: 36rpx;
  line-height: 1;
}

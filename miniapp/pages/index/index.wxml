<view class="plaza">
  <!-- 渐变头部：左上角是我的头像与会员号 -->
  <view class="hero">
    <view class="me" bindtap="goProfile">
      <view class="me-avatar-wrap">
        <mh-avatar src="{{me.avatar_url}}" user-id="{{me.id}}" size="104" />
      </view>
      <view class="me-info">
        <view class="me-name-row">
          <text class="me-name ellipsis">{{me.nickname || '未登录'}}</text>
          <view wx:if="{{memberNo}}" class="me-no" catchtap="onCopyMemberNo">
            <text class="me-no-label">NO.{{memberNo}}</text>
            <text class="me-no-copy">⧉</text>
          </view>
        </view>

        <view wx:if="{{!isLoggedIn}}" class="me-login-hint">登录后开启拆盒 ✨</view>

        <view wx:else class="me-pills">
          <text wx:if="{{me.is_member}}" class="me-pill is-vip">◈ 会员</text>
          <text wx:if="{{genderLabel}}" class="me-pill">{{genderLabel}}</text>
          <text wx:if="{{me.credit_score}}" class="me-pill">⛨ 信誉 {{me.credit_score}}</text>
        </view>
      </view>
    </view>

    <!-- 今日配额单独成卡，比原来的小胶囊更有存在感 -->
    <view wx:if="{{quota}}" class="quota-card">
      <text class="quota-icon">🎲</text>
      <text class="quota-text">今日剩余拆盒</text>
      <view class="quota-val">
        <text class="quota-hl">{{quota.remaining}}</text>
        <text class="quota-total">/{{quota.limit}}</text>
      </view>
    </view>
  </view>

  <!-- Tab 栏 -->
  <view class="tabs">
    <view
      class="tab {{activeTab === 'plaza' ? 'is-active' : ''}}"
      bindtap="onTabTap"
      data-tab="plaza"
    >盲盒广场</view>
    <view
      class="tab {{activeTab === 'following' ? 'is-active' : ''}}"
      bindtap="onTabTap"
      data-tab="following"
    >我关注的</view>
  </view>

  <!-- ============ 盲盒广场 ============ -->
  <block wx:if="{{activeTab === 'plaza'}}">
    <view class="filters">
      <!-- 排序 / 地区：固定三项，不横滑 -->
      <view class="filter-bar">
        <view
          class="filter-item {{!category && !city && !sort ? 'is-active' : ''}}"
          bindtap="onResetFilters"
        >全部</view>
        <view
          class="filter-item {{sort === 'meeting_time' ? 'is-active' : ''}}"
          bindtap="onSortTap"
        >时间 <text class="filter-icon">{{sort === 'meeting_time' ? '✓' : '▾'}}</text></view>
        <view
          class="filter-item {{city ? 'is-active' : ''}}"
          bindtap="onCityTap"
        >{{city || '地区'}} <text class="filter-icon">▾</text></view>
      </view>

      <!-- 分类：横滑 -->
      <scroll-view class="category-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="category-row">
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="category-chip {{category === item ? 'is-active' : ''}}"
            bindtap="onCategoryTap"
            data-value="{{item}}"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>

    <view class="list">
      <mh-skeleton wx:if="{{loading && !boxes.length}}" count="3" type="card" />

      <block wx:elif="{{boxes.length}}">
        <mh-box-card
          wx:for="{{boxes}}"
          wx:key="id"
          box="{{item}}"
          bindtap="onBoxTap"
        />
        <view class="list-footer">
          <text wx:if="{{loading}}" class="list-footer-text">加载中...</text>
          <text wx:elif="{{hasMore}}" class="list-footer-text">加载更多...</text>
          <text wx:else class="list-footer-text">— 已经到底了 —</text>
        </view>
      </block>

      <mh-empty
        wx:else
        icon="🎁"
        text="还没有符合条件的盲盒"
        hint="换个筛选条件试试～"
      />
    </view>
  </block>

  <!-- ============ 我关注的 ============ -->
  <block wx:else>
    <view class="list">
      <mh-skeleton wx:if="{{followingLoading}}" count="2" type="card" />

      <block wx:elif="{{followingGroups.length}}">
        <view wx:for="{{followingGroups}}" wx:key="index" class="group">
          <view class="group-head" bindtap="onCreatorTap" data-id="{{item.creator.id}}">
            <view class="group-head-left">
              <mh-avatar
                src="{{item.creator.avatar_url}}"
                user-id="{{item.creator.id}}"
                size="56"
              />
              <text class="group-name ellipsis">{{item.creator.nickname}}</text>
              <text class="group-count">{{item.boxes.length}} 个盲盒</text>
            </view>
            <text class="group-arrow">›</text>
          </view>

          <scroll-view class="group-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
            <view class="group-row">
              <mh-box-card
                wx:for="{{item.boxes}}"
                wx:for-item="box"
                wx:key="id"
                box="{{box}}"
                compact="{{true}}"
                bindtap="onBoxTap"
              />
            </view>
          </scroll-view>
        </view>
      </block>

      <mh-empty
        wx:else
        icon="👀"
        text="还没有关注的 TA"
        hint="{{followingError || '去广场发现感兴趣的发盒者吧'}}"
      />
    </view>
  </block>

  <!-- 发盒入口 -->
  <view wx:if="{{isLoggedIn}}" class="fab" bindtap="goPublish">
    <text class="fab-icon">🎁</text>我要发盒
  </view>
</view>

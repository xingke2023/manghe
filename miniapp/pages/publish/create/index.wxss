.loading-wrap {
  padding-top: 200rpx;
  display: flex;
  justify-content: center;
}

/* —— 凭证核销 —— */
.vc-head {
  padding: 40rpx 32rpx 0;
  display: flex;
  flex-direction: column;
}
.vc-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
}
.vc-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-hint);
}
.vc-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 2rpx solid transparent;
}
.vc-item.is-active {
  border-color: var(--gray-900);
}
.vc-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 9999rpx;
  border: 2rpx solid var(--gray-300);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.vc-item.is-active .vc-radio {
  border-color: var(--gray-900);
}
.vc-radio-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 9999rpx;
  background-color: var(--gray-900);
}
.vc-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.vc-code {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  color: var(--color-text);
}
.vc-valid {
  font-size: 22rpx;
  color: var(--color-text-hint);
}
.vc-error {
  padding: 0 8rpx;
  font-size: 24rpx;
  color: var(--color-accent);
}

/* —— 封面 —— */
.cover {
  position: relative;
  height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: var(--gray-50);
  border: 1rpx dashed var(--gray-300);
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.cover-plus {
  font-size: 60rpx;
  color: var(--gray-400);
  line-height: 1;
}
.cover-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
}
.cover-tips {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cover-tip {
  font-size: 22rpx;
  color: var(--gray-400);
}

/* —— 特质 —— */
.gap-16 {
  gap: 16rpx;
}
.chip-x {
  font-size: 20rpx;
}
.trait-add {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.trait-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background-color: var(--gray-100);
  font-size: 26rpx;
}
.trait-btn {
  flex-shrink: 0;
  background-color: var(--gray-900);
  color: #ffffff;
}

/* —— 体验价值 —— */
.exp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.exp-item {
  width: 148rpx;
  padding: 20rpx 8rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--gray-200);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.exp-item.is-active {
  border-color: var(--gray-900);
  background-color: var(--gray-900);
}
.exp-emoji {
  font-size: 36rpx;
  line-height: 1;
}
.exp-label {
  font-size: 20rpx;
  color: #374151;
  text-align: center;
}
.exp-item.is-active .exp-label {
  color: #ffffff;
}

/* —— 协议 —— */
.agree {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx;
}
.agree-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--gray-300);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.agree-box.is-checked {
  background-color: var(--gray-900);
  border-color: var(--gray-900);
}
.agree-tick {
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
}
.agree-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* —— 引导页 —— */
.intro-card {
  background: linear-gradient(160deg, #fff1e6 0%, #ffe8dc 100%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
}
.intro-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
}
.intro-sub {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
}
.intro-inner {
  margin-top: 32rpx;
  padding: 28rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  font-size: var(--fs-secondary);
  color: var(--color-text);
  line-height: 1.6;
}
.tips {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.tip {
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* —— 答题 —— */
.quiz-progress {
  margin: 0;
  border-radius: 0;
  height: 6rpx;
}
.quiz {
  padding: 48rpx 32rpx 0;
}
.quiz-badge {
  display: inline-block;
  padding: 8rpx 22rpx;
  border-radius: 9999rpx;
  background-color: var(--color-accent-bg);
  color: var(--color-accent);
  font-size: var(--fs-mini);
}
.quiz-question {
  display: block;
  margin-top: 28rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.5;
}
.quiz-options {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.quiz-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background-color: var(--color-card);
}
.quiz-option.is-active {
  background-color: var(--gray-900);
}
.quiz-option-key {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 9999rpx;
  background-color: var(--gray-100);
  color: var(--color-text-secondary);
  font-size: var(--fs-caption);
  text-align: center;
  line-height: 48rpx;
}
.quiz-option.is-active .quiz-option-key {
  background-color: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}
.quiz-option-text {
  flex: 1;
  font-size: var(--fs-secondary);
  color: var(--color-text);
  line-height: 1.5;
}
.quiz-option.is-active .quiz-option-text {
  color: #ffffff;
}

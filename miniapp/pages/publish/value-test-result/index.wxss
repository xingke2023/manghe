.result {
  min-height: 100vh;
  padding: 0 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.result-emoji {
  font-size: 120rpx;
  line-height: 1;
}
.result-title {
  margin-top: 40rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text);
}
.result-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
}
.result-btn {
  width: 100%;
  margin-top: 80rpx;
}

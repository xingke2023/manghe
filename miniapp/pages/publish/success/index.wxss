.success {
  min-height: 100vh;
  padding: 0 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.success-emoji {
  font-size: 120rpx;
  line-height: 1;
}
.success-title {
  margin-top: 40rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text);
}
.success-desc {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
.success-actions {
  width: 100%;
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

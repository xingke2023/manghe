.head {
  padding: 28rpx 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.head-count {
  font-size: 24rpx;
  color: var(--color-text-hint);
}
.head-action {
  font-size: 26rpx;
  color: var(--color-accent);
}

.notice {
  padding: 28rpx 32rpx;
  background-color: var(--color-card);
  border-radius: 32rpx;
}
/* 未读用红色左边框标出 */
.notice.is-unread {
  border-left: 8rpx solid var(--red-400);
}
.notice-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.notice-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}
.notice-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-hint);
}
.notice-content {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.list-footer {
  padding: 24rpx 0 8rpx;
  text-align: center;
}
.list-footer-text {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

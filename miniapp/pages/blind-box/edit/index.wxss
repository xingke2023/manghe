.loading-wrap {
  padding-top: 300rpx;
  display: flex;
  justify-content: center;
}

/* —— 封面 —— */
.cover {
  position: relative;
  height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: var(--gray-50);
  border: 1rpx dashed var(--gray-300);
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.cover-plus {
  font-size: 60rpx;
  color: var(--gray-400);
  line-height: 1;
}
.cover-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
}
.cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* —— 特质标签 —— */
.chip-row {
  gap: 16rpx;
}
.chip-x {
  font-size: 20rpx;
}
.trait-add {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.trait-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background-color: var(--gray-100);
  font-size: 26rpx;
}
.trait-btn {
  flex-shrink: 0;
  background-color: var(--gray-900);
  color: #ffffff;
}

/* —— 体验价值 4 列网格 —— */
.exp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.exp-item {
  width: 148rpx;
  padding: 20rpx 8rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--gray-200);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.exp-item.is-active {
  border-color: var(--gray-900);
  background-color: var(--gray-900);
}
.exp-emoji {
  font-size: 36rpx;
  line-height: 1;
}
.exp-label {
  font-size: 20rpx;
  color: #374151;
  text-align: center;
}
.exp-item.is-active .exp-label {
  color: #ffffff;
}

<view class="detail">
  <!-- 自定义导航栏 -->
  <view class="nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">活动详情</text>
    </view>
  </view>

  <!-- 骨架 -->
  <view wx:if="{{loading}}" class="skeleton-wrap">
    <view class="skeleton-block sk-cover"></view>
    <view class="skeleton-block sk-card"></view>
    <view class="skeleton-block sk-card"></view>
  </view>

  <block wx:elif="{{box}}">
    <!-- ============ 活动封面 + 标题 ============ -->
    <view class="cover">
      <image wx:if="{{box.cover_image}}" class="cover-img" src="{{box.cover_image}}" mode="aspectFill" />
      <view wx:else class="cover-empty">🎁</view>
      <view wx:if="{{categoryLabel}}" class="cover-badge">
        <text class="cover-badge-dot">●</text>{{categoryLabel}}
      </view>
      <text wx:if="{{statusLabel}}" class="cover-status {{statusClass}}">{{statusLabel}}</text>
    </view>

    <view class="head">
      <text class="head-title">{{box.title}}</text>
      <view class="head-row">
        <text class="head-fee">{{box.fee_label}}</text>
        <text wx:if="{{countdown}}" class="head-countdown">{{countdown}}</text>
      </view>
    </view>

    <view class="card-list">
      <!-- ============ 活动信息 ============ -->
      <view class="card">
        <view class="card-title">活动信息</view>

        <view class="info-row">
          <text class="info-icon">🕐</text>
          <view class="info-body">
            <text class="info-label">活动时间</text>
            <text class="info-value">{{meetingText}}</text>
          </view>
        </view>

        <view class="info-row">
          <text class="info-icon">📍</text>
          <view class="info-body">
            <text class="info-label">活动地点</text>
            <text class="info-value">{{box.location}}</text>
            <text wx:if="{{regionText}}" class="info-sub">{{regionText}}</text>
          </view>
        </view>

        <view class="info-row">
          <text class="info-icon">👥</text>
          <view class="info-body">
            <text class="info-label">招募人数</text>
            <text class="info-value">{{participantText}}</text>
          </view>
        </view>

        <view wx:if="{{box.checkin_start_time}}" class="info-row">
          <text class="info-icon">✅</text>
          <view class="info-body">
            <text class="info-label">打卡时段</text>
            <text class="info-value">{{box.checkin_start_time}} — {{box.checkin_end_time}}</text>
            <text class="info-sub">需在活动地点 300 米内完成 GPS 打卡</text>
          </view>
        </view>

        <view class="info-row">
          <text class="info-icon">💰</text>
          <view class="info-body">
            <text class="info-label">费用方式</text>
            <text class="info-value">{{box.fee_label}}</text>
          </view>
        </view>
      </view>

      <!-- ============ 体验价值 ============ -->
      <view class="card" wx:if="{{box.experience_values.length}}">
        <view class="card-title">这场活动能收获什么</view>
        <view class="wrap chip-gap">
          <text wx:for="{{box.experience_values}}" wx:key="*this" class="tag-orange">{{item}}</text>
        </view>
      </view>

      <!-- ============ 期待同行者 ============ -->
      <view class="card" wx:if="{{box.expected_traits.length}}">
        <view class="card-title">期待什么样的同行者</view>
        <view class="wrap chip-gap">
          <text wx:for="{{box.expected_traits}}" wx:key="*this" class="tag-blue">{{item}}</text>
        </view>
      </view>

      <!-- ============ 已报名的人 ============ -->
      <view class="card">
        <view class="plan-head">
          <view class="card-title plan-title">已报名</view>
          <text class="stat-inline">{{box.apply_count || 0}} 人报名 · {{box.view_count || 0}} 人看过</text>
        </view>
        <view wx:if="{{applicantAvatars.length}}" class="avatar-stack">
          <view
            wx:for="{{applicantAvatars}}"
            wx:key="id"
            class="stack-item"
            style="margin-left: {{index === 0 ? '0' : '-18rpx'}}; z-index: {{10 - index}};"
          >
            <mh-avatar src="{{item.avatar_url}}" user-id="{{item.id}}" size="64" />
          </view>
        </view>
        <text wx:else class="none-yet">还没有人报名，来做第一个</text>
      </view>

      <!-- ============ 发起人（次要信息，放在活动内容之后）============ -->
      <view class="card" wx:if="{{box.creator}}">
        <view class="card-title">发起人</view>
        <view class="owner">
          <mh-avatar
            src="{{box.creator.avatar_url}}"
            user-id="{{box.creator.id}}"
            size="96"
            bindtap="onCreatorTap"
          />
          <view class="owner-info" bindtap="onCreatorTap">
            <view class="owner-name-row">
              <text class="owner-name">{{box.creator.nickname}}</text>
              <text wx:if="{{box.creator.is_member}}" class="owner-vip">会员</text>
            </view>
            <text wx:if="{{creatorMeta}}" class="owner-meta">{{creatorMeta}}</text>
          </view>
          <view
            wx:if="{{!isCreator}}"
            class="btn-sm follow-btn {{isFollowing ? 'is-following' : ''}}"
            catchtap="onToggleFollow"
          >{{followLoading ? '...' : (isFollowing ? '已关注' : '关注')}}</view>
        </view>

        <text wx:if="{{box.creator.profile.about_me}}" class="owner-about">{{box.creator.profile.about_me}}</text>

        <view wx:if="{{box.creator.profile.interests.length}}" class="owner-interests">
          <text wx:for="{{box.creator.profile.interests}}" wx:key="*this" class="chip">{{item}}</text>
        </view>

        <!-- 兴趣相册：非本人看到的是模糊图，需申请授权 -->
        <block wx:if="{{hasPhotos}}">
          <view class="photo-row">
            <view
              wx:for="{{box.creator.profile.interest_photos}}"
              wx:key="*this"
              class="photo-slot"
              bindtap="onPhotoTap"
              data-url="{{item}}"
            >
              <image
                class="photo-img {{canViewPhotos ? '' : 'is-blurred'}}"
                src="{{item}}"
                mode="aspectFill"
              />
              <view wx:if="{{!canViewPhotos}}" class="photo-lock">🔒</view>
            </view>
          </view>
          <view wx:if="{{!canViewPhotos}}" class="photo-request">
            <text class="photo-request-text">{{photoRequestHint}}</text>
            <view
              wx:if="{{photoRequestStatus === 0 || photoRequestStatus === 3}}"
              class="btn-sm photo-request-btn"
              catchtap="onRequestPhotos"
            >{{photoRequesting ? '提交中...' : '申请查看'}}</view>
          </view>
        </block>
      </view>

      <!-- ============ 报名名单（仅发起人可见）============ -->
      <view class="card" wx:if="{{isCreator}}">
        <view class="card-title">报名名单</view>
        <view wx:if="{{applicationsLoading}}" class="applicant-loading">加载中...</view>
        <block wx:elif="{{applications.length}}">
          <view wx:for="{{applications}}" wx:key="id" class="applicant">
            <mh-avatar
              src="{{item.applicant.avatar}}"
              user-id="{{item.applicant.id}}"
              size="88"
              bindtap="onApplicantTap"
              data-id="{{item.applicant.id}}"
            />
            <view class="applicant-info" bindtap="onApplicantTap" data-id="{{item.applicant.id}}">
              <text class="applicant-name">{{item.applicant.nickname}}</text>
              <text class="applicant-date">{{item.created_at}}</text>
            </view>
            <!-- status: 1 待处理 / 2 已锁定 / 3 已拒绝 -->
            <text wx:if="{{item.status === 2}}" class="badge-green">已锁定</text>
            <text wx:elif="{{item.status === 3}}" class="badge-gray">已拒绝</text>
            <view wx:else class="applicant-actions">
              <view
                class="btn-sm applicant-reject"
                bindtap="onRejectApplication"
                data-id="{{item.id}}"
              >拒绝</view>
              <view
                class="btn-sm applicant-lock"
                bindtap="onLockApplication"
                data-id="{{item.id}}"
              >锁定</view>
            </view>
          </view>
        </block>
        <view wx:else class="applicant-empty">还没有人报名，再等等～</view>
      </view>

      <view class="publish-time">发布于 {{publishedText}}</view>
    </view>

    <view class="bottom-bar-spacer"></view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <block wx:if="{{isCreator}}">
        <button class="btn btn-outline share-btn" open-type="share">分享</button>
        <block wx:if="{{box.status === 1}}">
          <view class="btn btn-outline flex-1" bindtap="goEdit">修改</view>
          <view class="btn btn-primary flex-1" bindtap="onUnpublish">下架</view>
        </block>
      </block>
      <block wx:else>
        <view class="chat-icon" bindtap="onOpenChat">💬</view>
        <button class="btn btn-outline share-btn" open-type="share">分享</button>
        <view
          class="btn flex-1 {{actionDisabled ? 'btn-primary is-disabled' : 'btn-accent'}}"
          bindtap="onApply"
        >{{applying ? '处理中...' : actionLabel}}</view>
      </block>
    </view>
  </block>

  <!-- 一次性聊天弹层 -->
  <block wx:if="{{showChat}}">
    <view class="mask" bindtap="onCloseChat"></view>
    <view class="sheet chat-sheet">
      <view class="sheet-handle"></view>
      <view class="chat-sheet-head">
        <text class="chat-sheet-title">和 {{box.creator.nickname}} 打个招呼</text>
        <text class="chat-sheet-close" bindtap="onCloseChat">✕</text>
      </view>
      <scroll-view class="chat-sheet-body" scroll-y scroll-into-view="{{scrollAnchor}}">
        <view wx:if="{{chatLoading}}" class="chat-tip">加载中...</view>
        <view wx:elif="{{!chatMessages.length}}" class="chat-tip">还没有消息，先说点什么吧</view>
        <view
          wx:for="{{chatMessages}}"
          wx:key="id"
          class="msg {{item.is_mine ? 'is-mine' : ''}}"
        >
          <text class="msg-bubble">{{item.content}}</text>
        </view>
        <view id="chat-bottom"></view>
      </scroll-view>
      <view class="chat-sheet-input">
        <input
          class="chat-input"
          value="{{chatInput}}"
          maxlength="500"
          placeholder="{{canSendChat ? '说点什么...' : '等 TA 回复后可继续发送'}}"
          placeholder-class="form-input-placeholder"
          disabled="{{!canSendChat}}"
          bindinput="onChatInput"
          bindconfirm="onSendChat"
        />
        <view
          class="chat-send {{(!chatInput || !canSendChat || chatSending) ? 'is-disabled' : ''}}"
          bindtap="onSendChat"
        >▲</view>
      </view>
    </view>
  </block>
</view>

.detail {
  min-height: 100vh;
  background-color: var(--color-bg);
}

/* —— 自定义导航 —— */
.nav {
  position: sticky;
  top: 0;
  z-index: 30;
  background-color: var(--color-card);
  border-bottom: 1rpx solid var(--color-border);
}

/* —— 骨架 —— */
.skeleton-wrap {
  padding: 0 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.sk-cover {
  height: 480rpx;
  border-radius: 0;
}
.sk-card {
  height: 220rpx;
  border-radius: 32rpx;
  margin: 0 32rpx;
}

/* —— 活动封面 —— */
.cover {
  position: relative;
  height: 480rpx;
  background: linear-gradient(135deg, #ffe8e0 0%, #fff0e8 100%);
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
}
.cover-badge {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  background-color: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: var(--fs-mini);
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.cover-badge-dot {
  color: #ff9f45;
  font-size: 16rpx;
}
/* 非「进行中」的状态盖在封面右上角 */
.cover-status {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  padding: 8rpx 22rpx;
  border-radius: 9999rpx;
  font-size: var(--fs-mini);
  color: #ffffff;
}
.cover-status.is-blue {
  background-color: rgba(37, 99, 235, 0.85);
}
.cover-status.is-gray {
  background-color: rgba(0, 0, 0, 0.55);
}

/* —— 标题区 —— */
.head {
  background-color: var(--color-card);
  padding: 32rpx;
}
.head-title {
  display: block;
  font-size: 42rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.35;
}
.head-row {
  margin-top: 20rpx;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.head-fee {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--color-accent);
  line-height: 1.2;
}
.head-countdown {
  padding: 6rpx 20rpx;
  border-radius: 9999rpx;
  background-color: var(--color-accent-bg);
  color: var(--color-accent);
  font-size: var(--fs-mini);
}

/* —— 活动信息行 —— */
.info-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.info-icon {
  font-size: var(--fs-section);
  line-height: 1.4;
  flex-shrink: 0;
}
.info-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.info-label {
  font-size: var(--fs-mini);
  color: var(--color-text-hint);
}
.info-value {
  font-size: var(--fs-body);
  color: var(--color-text);
  line-height: 1.5;
}
.info-sub {
  font-size: var(--fs-mini);
  color: var(--color-text-hint);
  line-height: 1.5;
}

.chip-gap {
  gap: 16rpx;
}

/* —— 已报名 —— */
.plan-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.plan-title {
  margin-bottom: 0;
}
.stat-inline {
  font-size: var(--fs-mini);
  color: var(--color-text-hint);
  flex-shrink: 0;
}
.avatar-stack {
  display: flex;
  align-items: center;
}
.stack-item {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 9999rpx;
  border: 3rpx solid var(--color-card);
  box-sizing: content-box;
  flex-shrink: 0;
  overflow: hidden;
  background-color: var(--color-card);
}
.none-yet {
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
}

/* —— 发起人（次要区块）—— */
.owner {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.owner-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.owner-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.owner-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text);
}
.owner-vip {
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  background-color: #fef3c7;
  color: #b45309;
  font-size: var(--fs-mini);
}
.owner-meta {
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
}
.follow-btn {
  flex-shrink: 0;
  background-color: var(--color-accent);
  color: #ffffff;
}
.follow-btn.is-following {
  background-color: var(--color-card);
  border: 1rpx solid var(--gray-200);
  color: var(--color-text-secondary);
}
.owner-about {
  display: block;
  margin-top: 24rpx;
  font-size: var(--fs-secondary);
  color: var(--color-text-secondary);
  line-height: 1.7;
}
.owner-interests {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* —— 兴趣相册 —— */
.photo-row {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}
.photo-slot {
  position: relative;
  flex: 1;
  height: 180rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: var(--gray-100);
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-img.is-blurred {
  filter: blur(16rpx);
}
.photo-lock {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.photo-request {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.photo-request-text {
  flex: 1;
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
}
.photo-request-btn {
  flex-shrink: 0;
  background-color: var(--gray-900);
  color: #ffffff;
}

/* —— 报名名单 —— */
.applicant {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.applicant:last-child {
  border-bottom: none;
}
.applicant-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.applicant-name {
  font-size: var(--fs-secondary);
  color: var(--color-text);
}
.applicant-date {
  font-size: var(--fs-mini);
  color: var(--color-text-hint);
}
.applicant-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.applicant-reject {
  background-color: var(--gray-100);
  color: var(--color-text-secondary);
}
.applicant-lock {
  background-color: var(--gray-900);
  color: #ffffff;
}
.applicant-loading,
.applicant-empty {
  padding: 32rpx 0;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
}

.publish-time {
  padding: 8rpx 8rpx 0;
  text-align: center;
  font-size: var(--fs-mini);
  color: var(--gray-400);
}

/* —— 底部操作栏 —— */
.chat-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 9999rpx;
  border: 1rpx solid var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
/* button 元素需要抹掉小程序默认样式，才能和 view 版按钮排在一行 */
.share-btn {
  flex-shrink: 0;
  width: auto;
  padding: 0 36rpx;
  margin: 0;
  line-height: 1;
  font-size: var(--fs-secondary);
}
.share-btn::after {
  border: none;
}

/* —— 聊天弹层 —— */
.chat-sheet {
  height: 70vh;
  display: flex;
  flex-direction: column;
}
.chat-sheet-head {
  padding: 8rpx 32rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--color-border);
}
.chat-sheet-title {
  font-size: var(--fs-body);
  font-weight: 600;
}
.chat-sheet-close {
  font-size: 32rpx;
  color: var(--gray-400);
  padding: 8rpx 12rpx;
}
.chat-sheet-body {
  flex: 1;
  padding: 24rpx 32rpx;
}
.chat-tip {
  padding: 60rpx 0;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
}
.msg {
  display: flex;
  margin-bottom: 20rpx;
}
.msg.is-mine {
  justify-content: flex-end;
}
.msg-bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  background-color: var(--gray-100);
  color: var(--color-text);
  font-size: var(--fs-secondary);
  line-height: 1.5;
}
.msg.is-mine .msg-bubble {
  background-color: var(--blue-500);
  color: #ffffff;
}
.chat-sheet-input {
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 9999rpx;
  background-color: var(--gray-100);
  font-size: var(--fs-secondary);
}
.chat-send {
  width: 76rpx;
  height: 76rpx;
  border-radius: 9999rpx;
  background-color: var(--gray-900);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-secondary);
  flex-shrink: 0;
}
.chat-send.is-disabled {
  background-color: var(--gray-300);
}

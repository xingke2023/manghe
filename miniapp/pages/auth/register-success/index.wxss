.success {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffe0e0 0%, #fff5f0 45%, #f5f5f5 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 64rpx;
}
.mascot {
  width: 280rpx;
  height: 280rpx;
  margin-top: 200rpx;
}
.title {
  margin-top: 32rpx;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-text);
}
.subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  text-align: center;
}
.explore-btn {
  width: 100%;
  margin-top: 80rpx;
}

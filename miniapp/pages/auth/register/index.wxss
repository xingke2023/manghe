.wizard-head {
  padding: 32rpx 32rpx 8rpx;
}
.wizard-step {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.wizard-step-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
}
.wizard-step-sub {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

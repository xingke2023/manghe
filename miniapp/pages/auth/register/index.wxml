<view class="page-wrap wizard">
  <view class="wizard-head">
    <view class="progress-track">
      <view class="progress-fill" style="width: 33%"></view>
    </view>
    <view class="wizard-step">
      <text class="wizard-step-title">基本信息</text>
      <text class="wizard-step-sub">第 1 / 3 步</text>
    </view>
  </view>

  <view class="card-list">
    <view class="card">
      <view class="form-row">
        <text class="form-label">昵称</text>
        <input
          class="form-input"
          maxlength="12"
          value="{{nickname}}"
          placeholder="怎么称呼你"
          placeholder-class="form-input-placeholder"
          bindinput="onInput"
          data-field="nickname"
        />
      </view>
      <view class="form-row">
        <text class="form-label">身高</text>
        <input
          class="form-input"
          type="number"
          maxlength="3"
          value="{{height}}"
          placeholder="cm"
          placeholder-class="form-input-placeholder"
          bindinput="onInput"
          data-field="height"
        />
      </view>
      <view class="form-row">
        <text class="form-label">所在城市</text>
        <input
          class="form-input"
          maxlength="10"
          value="{{city}}"
          placeholder="例如 杭州"
          placeholder-class="form-input-placeholder"
          bindinput="onInput"
          data-field="city"
        />
      </view>
      <picker
        mode="date"
        value="{{birthDate}}"
        start="1970-01-01"
        end="2008-12-31"
        bindchange="onBirthDateChange"
      >
        <view class="form-row">
          <text class="form-label">出生日期</text>
          <view class="form-input {{birthDate ? '' : 'form-input-placeholder'}}">
            {{birthDate || '请选择'}}
          </view>
        </view>
      </picker>
    </view>

    <view class="card">
      <view class="card-title">性别</view>
      <view class="toggle-group">
        <view
          class="toggle-item {{gender === 1 ? 'is-active' : ''}}"
          bindtap="onGenderTap"
          data-value="1"
        >♂ 男</view>
        <view
          class="toggle-item {{gender === 2 ? 'is-active' : ''}}"
          bindtap="onGenderTap"
          data-value="2"
        >♀ 女</view>
      </view>
    </view>
  </view>

  <view class="bottom-bar-spacer"></view>
  <view class="bottom-bar">
    <view
      class="btn btn-primary flex-1 {{saving ? 'is-disabled' : ''}}"
      bindtap="onNext"
    >{{saving ? '保存中...' : '下一步'}}</view>
  </view>
</view>

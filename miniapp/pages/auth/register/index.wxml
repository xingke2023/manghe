<view class="page-wrap wizard">
  <view class="wizard-head">
    <view class="progress-track">
      <view class="progress-fill" style="width: 33%"></view>
    </view>
    <view class="wizard-step">
      <text class="wizard-step-title">基本信息</text>
      <text class="wizard-step-sub">第 1 / 3 步</text>
    </view>
  </view>

  <!-- 表单用 WeUI 单元格：对齐、分割线、点击态都由 WeUI 负责 -->
  <view class="weui-cells weui-cells_form form-block">
    <view class="weui-cell">
      <view class="weui-cell__hd"><view class="weui-label">昵称</view></view>
      <view class="weui-cell__bd">
        <input
          class="weui-input"
          maxlength="12"
          value="{{nickname}}"
          placeholder="怎么称呼你"
          bindinput="onInput"
          data-field="nickname"
        />
      </view>
    </view>
    <view class="weui-cell">
      <view class="weui-cell__hd"><view class="weui-label">身高</view></view>
      <view class="weui-cell__bd">
        <input
          class="weui-input"
          type="number"
          maxlength="3"
          value="{{height}}"
          placeholder="cm"
          bindinput="onInput"
          data-field="height"
        />
      </view>
    </view>
    <view class="weui-cell">
      <view class="weui-cell__hd"><view class="weui-label">所在城市</view></view>
      <view class="weui-cell__bd">
        <input
          class="weui-input"
          maxlength="10"
          value="{{city}}"
          placeholder="例如 杭州"
          bindinput="onInput"
          data-field="city"
        />
      </view>
    </view>
    <!-- 日期选择用 weui-cell_access，右侧自带箭头 -->
    <picker
      mode="date"
      value="{{birthDate}}"
      start="1970-01-01"
      end="2008-12-31"
      bindchange="onBirthDateChange"
    >
      <view class="weui-cell weui-cell_access">
        <view class="weui-cell__hd"><view class="weui-label">出生日期</view></view>
        <view class="weui-cell__bd">
          <view class="picker-value {{birthDate ? '' : 'is-placeholder'}}">
            {{birthDate || '请选择'}}
          </view>
        </view>
        <view class="weui-cell__ft weui-cell__ft_in-access"></view>
      </view>
    </picker>
  </view>

  <!-- 性别是二选一切换，WeUI 没有对应控件，保留自有样式 -->
  <view class="weui-cells__title">性别</view>
  <view class="card toggle-card">
    <view class="toggle-group">
      <view
        class="toggle-item {{gender === 1 ? 'is-active' : ''}}"
        bindtap="onGenderTap"
        data-value="1"
      >♂ 男</view>
      <view
        class="toggle-item {{gender === 2 ? 'is-active' : ''}}"
        bindtap="onGenderTap"
        data-value="2"
      >♀ 女</view>
    </view>
  </view>

  <view class="bottom-bar-spacer"></view>
  <view class="bottom-bar">
    <view
      class="btn btn-primary flex-1 {{saving ? 'is-disabled' : ''}}"
      bindtap="onNext"
    >{{saving ? '保存中...' : '下一步'}}</view>
  </view>
</view>

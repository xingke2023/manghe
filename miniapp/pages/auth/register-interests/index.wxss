.wizard-head {
  padding: 32rpx 32rpx 8rpx;
}
.wizard-step {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.wizard-step-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
}
.wizard-step-sub {
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
}

.card-title-hint {
  font-size: var(--fs-caption);
  font-weight: 400;
  color: var(--color-text-hint);
}
.counter {
  margin-top: 8rpx;
  text-align: right;
  font-size: var(--fs-mini);
  color: var(--color-text-hint);
}

.chip-row {
  gap: 20rpx;
}
.chip-x {
  font-size: var(--fs-mini);
}

.tag-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 8rpx 4rpx 24rpx;
  border-radius: 9999rpx;
  border: 1rpx solid var(--gray-300);
}
.tag-input {
  width: 180rpx;
  font-size: var(--fs-caption);
  height: 48rpx;
}
.tag-confirm {
  font-size: var(--fs-caption);
  color: var(--color-accent);
  padding: 8rpx 20rpx;
}

/* 相册 3 列网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-cell {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: var(--gray-100);
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 9999rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: var(--fs-mini);
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-add {
  border: 1rpx dashed var(--gray-300);
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-add-plus {
  font-size: 44rpx;
  color: var(--gray-400);
  line-height: 1;
}
.photo-add-text {
  font-size: var(--fs-caption);
  color: var(--gray-400);
}

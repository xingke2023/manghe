.wizard-head {
  padding: 32rpx 32rpx 8rpx;
}
.wizard-step {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.wizard-step-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
}
.wizard-step-sub {
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
}

.chip-row {
  gap: 20rpx;
}

.age-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.age-label {
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
}
.age-value {
  font-size: var(--fs-secondary);
  font-weight: 600;
  color: var(--color-text);
}
.age-summary {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
  text-align: center;
}

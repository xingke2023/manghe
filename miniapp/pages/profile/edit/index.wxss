.loading-wrap {
  padding-top: 300rpx;
  display: flex;
  justify-content: center;
}

/* —— 头像 —— */
.avatar-section {
  padding: 48rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.avatar-big {
  width: 176rpx;
  height: 176rpx;
  border-radius: 9999rpx;
  background-color: var(--gray-100);
  border: 6rpx solid #ffffff;
}
.avatar-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.gap-16 {
  gap: 16rpx;
}
.card-title-hint {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--color-text-hint);
}
.counter {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--color-text-hint);
}
.sub-title {
  margin-top: 32rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* —— 自定义兴趣 —— */
.custom-add {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.custom-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background-color: var(--gray-100);
  font-size: 26rpx;
}
.custom-btn {
  flex-shrink: 0;
  background-color: var(--gray-900);
  color: #ffffff;
}

/* —— 相册 —— */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-cell {
  position: relative;
  width: 196rpx;
  height: 196rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: var(--gray-100);
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-del {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 9999rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-add {
  border: 1rpx dashed var(--gray-300);
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-add-plus {
  font-size: 44rpx;
  color: var(--gray-400);
  line-height: 1;
}
.photo-add-text {
  font-size: 24rpx;
  color: var(--gray-400);
}

/* —— 真实资料 —— */
.real-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--gray-400);
}
/* 「真实资料」小节标题，weui-cells__title 默认上边距偏小，这里加大一点 */
.real-title {
  margin-top: 32rpx;
}
/* WeUI 单元格：加圆角与外边距，匹配本项目卡片风格 */
.form-block {
  border-radius: 24rpx;
  overflow: hidden;
}
.sub-title-first {
  margin-top: 0;
}

/* —— 头像选择弹层 —— */
.picker-sheet {
  max-height: 76vh;
}
.picker-body {
  padding: 8rpx 32rpx 32rpx;
}
.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}
.picker-scroll {
  margin-top: 24rpx;
  max-height: 46vh;
}
.picker-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.picker-cell {
  width: 148rpx;
  height: 148rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  background-color: var(--gray-50);
}
.picker-cell.is-active {
  border-color: var(--gray-900);
}
.picker-img {
  width: 100%;
  height: 100%;
}
.picker-confirm {
  margin-top: 32rpx;
}

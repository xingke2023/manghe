<view class="page-wrap">
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="spinner"></view>
  </view>

  <block wx:else>
    <view class="pv-hero">
      <mh-avatar
        class="pv-avatar"
        src="{{user.avatar_url}}"
        user-id="{{user.id}}"
        size="160"
      />
      <view class="pv-name-row">
        <text class="pv-name">{{user.nickname || '神秘人'}}</text>
        <text wx:if="{{user.is_member}}" class="pv-vip">会员</text>
      </view>
      <text wx:if="{{metaText}}" class="pv-meta">{{metaText}}</text>
      <view
        class="follow-btn {{following ? 'is-following' : ''}}"
        bindtap="onToggleFollow"
      >{{followLoading ? '...' : (following ? '已关注' : '关注 TA')}}</view>
    </view>

    <view class="card-list">
      <view class="card" wx:if="{{about}}">
        <view class="card-title">关于 TA</view>
        <text class="pv-about">{{about}}</text>
      </view>

      <view class="card" wx:if="{{purposes.length}}">
        <view class="card-title">找搭子的目的</view>
        <view class="pv-chips">
          <text wx:for="{{purposes}}" wx:key="*this" class="tag-orange">{{item}}</text>
        </view>
      </view>

      <view class="card" wx:if="{{interests.length}}">
        <view class="card-title">兴趣爱好</view>
        <view class="pv-chips">
          <text wx:for="{{interests}}" wx:key="*this" class="tag-blue">{{item}}</text>
        </view>
      </view>

      <!-- 相册是否可见由后端的 can_view_photos 决定。
           注意：无权限时后端会把 interest_photos 置成空数组，所以不能靠
           photos.length 判断"对方到底有没有相册"，只能按权限分支。 -->
      <view class="card" wx:if="{{canViewPhotos && photos.length}}">
        <view class="card-title">生活相册</view>
        <view class="pv-photos">
          <image
            wx:for="{{photos}}"
            wx:key="*this"
            class="pv-photo"
            src="{{item}}"
            mode="aspectFill"
            bindtap="onPhotoTap"
            data-url="{{item}}"
          />
        </view>
      </view>
      <view class="card" wx:elif="{{!canViewPhotos}}">
        <view class="card-title">生活相册</view>
        <view class="pv-locked">🔒 相册需要对方授权查看</view>
      </view>
    </view>
  </block>
</view>

.app {
  display: flex;
  gap: 20rpx;
}
.app-thumb {
  width: 168rpx;
  height: 168rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #ffe8e0 0%, #fff0e8 100%);
}
.app-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}
.app-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.app-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.app-title {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-secondary);
  font-weight: 600;
  color: var(--color-text);
}
.app-meta {
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
}
.app-result {
  font-size: var(--fs-caption);
  color: var(--color-accent);
}
.app-date {
  margin-top: auto;
  font-size: var(--fs-mini);
  color: var(--color-text-hint);
}

<view class="box-card {{compact ? 'is-compact' : ''}}" bindtap="onTap">
  <!-- 上半：封面 + 信息 -->
  <view class="card-main">
    <view class="cover">
      <image wx:if="{{box.cover_image}}" class="cover-img" src="{{box.cover_image}}" mode="aspectFill" />
      <view wx:else class="cover-placeholder">🎁</view>
      <view wx:if="{{categoryLabel}}" class="cover-badge">
        <text class="cover-badge-dot">●</text>
        <text>{{categoryLabel}}</text>
      </view>
    </view>

    <view class="info">
      <text class="title">{{box.title}}</text>

      <view wx:if="{{box.creator}}" class="creator">
        <mh-avatar src="{{box.creator.avatar_url}}" user-id="{{box.creator.id}}" size="40" />
        <text class="creator-name">{{box.creator.nickname}}</text>
        <text wx:if="{{box.creator.is_member}}" class="vip">VIP</text>
      </view>

      <view class="meta">
        <view class="meta-row">
          <text class="meta-icon">🕐</text>
          <text class="meta-text">{{box.meeting_time}}</text>
        </view>
        <view class="meta-row">
          <text class="meta-icon">📍</text>
          <text class="meta-text">{{place}}</text>
        </view>
      </view>

      <text class="fee">{{box.fee_label}}</text>
    </view>
  </view>

  <!-- 下半：参与者 -->
  <view class="participants">
    <view wx:if="{{applicants.length}}" class="avatar-stack">
      <view
        wx:for="{{applicants}}"
        wx:key="id"
        class="stack-item"
        style="z-index: {{10 - index}};"
      >
        <mh-avatar src="{{item.avatar_url}}" user-id="{{item.id}}" size="48" />
      </view>
    </view>
    <text wx:else class="no-one">还没有人报名，来做第一个</text>

    <view class="action-area">
      <view wx:if="{{box.apply_count}}" class="count-wrap">
        <text class="count-num">{{box.apply_count}}</text>
        <text class="count">人报名</text>
      </view>
      <view class="go-btn">去看看</view>
    </view>
  </view>
</view>

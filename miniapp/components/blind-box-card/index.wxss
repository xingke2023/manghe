/* 盲盒广场卡片。
   布局与视觉细节参考 gemini-3.1-pro-preview 的方案（双层柔和阴影、虚线分隔
   参与者区、VIP 渐变角标、带品牌色阴影的「去看看」胶囊），字号统一走全局 token。 */

.box-card {
  background-color: var(--color-card);
  border-radius: 32rpx;
  padding: 28rpx;
  /* 两层阴影：大而淡的做体积感，小而近的做贴合感 */
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03), 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}
/* 「我关注的」横向轮播里的窄卡 */
.box-card.is-compact {
  width: 600rpx;
  flex-shrink: 0;
}

/* —— 上半：封面 + 信息 —— */
.card-main {
  display: flex;
  gap: 28rpx;
}

.cover {
  position: relative;
  width: 200rpx;
  height: 260rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(135deg, var(--color-accent-bg) 0%, #fff5f0 100%);
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
}
/* 分类角标。backdrop-filter 在部分机型不生效，靠半透明底色兜底 */
.cover-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  background-color: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8rpx);
  color: #ffffff;
  font-size: var(--fs-mini);
  display: flex;
  align-items: center;
  gap: 8rpx;
  z-index: 1;
}
.cover-badge-dot {
  color: #ff9f45;
  font-size: var(--fs-mini);
  transform: scale(0.6);
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.title {
  font-size: var(--fs-section);
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.creator {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.creator-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.vip {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #fef3c7 0%, #fde68a 100%);
  color: #b45309;
  font-size: var(--fs-mini);
  font-weight: 600;
}

.meta {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.meta-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.meta-icon {
  font-size: var(--fs-caption);
  flex-shrink: 0;
}
.meta-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 费用：列表里最抓眼的数字 */
.fee {
  margin-top: auto;
  padding-top: 16rpx;
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--color-accent);
  line-height: 1;
}

/* —— 下半：参与者 —— */
.participants {
  margin-top: 28rpx;
  padding-top: 24rpx;
  /* 虚线分隔比实线更轻，避免把卡片切成两半 */
  border-top: 2rpx dashed var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

/* 头像叠放：容器补 padding 抵掉首个的负边距，靠前的层级更高 */
.avatar-stack {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding-left: 16rpx;
}
.stack-item {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 9999rpx;
  border: 4rpx solid var(--color-card);
  margin-left: -16rpx;
  background-color: var(--gray-100);
  overflow: hidden;
  box-sizing: content-box;
  flex-shrink: 0;
}
.no-one {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
}

.action-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
.count-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.count-num {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--color-text);
}
.count {
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
}
.go-btn {
  padding: 10rpx 28rpx;
  border-radius: 9999rpx;
  background-color: var(--color-accent);
  color: #ffffff;
  font-size: var(--fs-caption);
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(232, 55, 63, 0.3);
}

/* 只读资料展示的共享样式。profile/preview（看自己）和 profile/other（看别人）
   用 @import 引入，避免同一套卡片样式写两遍。 */

.pv-hero {
  background: linear-gradient(180deg, #ffe8e0 0%, #fff5f0 55%, #f5f5f5 100%);
  padding: 48rpx 32rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.pv-avatar {
  border: 6rpx solid #ffffff;
  border-radius: 9999rpx;
}
.pv-name-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.pv-name {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text);
}
.pv-vip {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background-color: #fef3c7;
  color: #b45309;
  font-size: var(--fs-mini);
}
.pv-meta {
  margin-top: 12rpx;
  font-size: var(--fs-caption);
  color: var(--color-text-secondary);
}

.pv-about {
  font-size: var(--fs-secondary);
  color: var(--color-text-secondary);
  line-height: 1.7;
}
.pv-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 生活相册 3 列 */
.pv-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.pv-photo {
  width: 196rpx;
  height: 196rpx;
  border-radius: 24rpx;
  background-color: var(--gray-100);
}
.pv-locked {
  padding: 60rpx 0;
  text-align: center;
  font-size: var(--fs-caption);
  color: var(--color-text-hint);
}

.pv-footnote {
  padding: 32rpx;
  text-align: center;
  font-size: var(--fs-mini);
  color: var(--gray-400);
}
